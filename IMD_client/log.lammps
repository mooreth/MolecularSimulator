# ------------------------------------------
# Molecular machine simulation
# ------------------------------------------

units metal
atom_style molecular
boundary s s s

read_data C:/LAMMPS/IMD/c60_240_collide.data
Reading data file ...
  orthogonal box = (-28 -17 -18) to (47 18 17)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  300 atoms
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.001 seconds
  read_data CPU = 0.007 seconds

# Load groups exported from SAMSON
include C:/LAMMPS/IMD/samson_groups.in
group motor1 id 248 251 253 254 255 258 259 261 262 266 268 271 272 275 276 297
16 atoms in group motor1
group free subtract all motor1
284 atoms in group free

# ------------------------------------------
# Interatomic potential
# ------------------------------------------

pair_style airebo 3.0 1 0
pair_coeff * * CH.airebo C C
Reading airebo potential file CH.airebo with DATE: 2011-10-25

# ------------------------------------------
# Integration
# ------------------------------------------

timestep 0.00025

# Integrate free atoms only.
# Motor and anchor jig atoms are excluded.
fix integrate_free free nve

# Thermostat free atoms
fix free_thermostat free temp/berendsen 300.0 300.0 0.25

# ------------------------------------------
# IMD connection
# ------------------------------------------

fix comm all imd 5678     unwrap off     fscale 100.0     trate 10     nowait on

# ------------------------------------------
# Diagnostics
# ------------------------------------------

thermo_style custom step atoms temp ke pe etotal
thermo 10
thermo_modify flush yes

# Python will control the simulation using run chunks.
run 0
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 12.2
  ghost atom cutoff = 12.2
  binsize = 6.1, bins = 9 3 3
  1 neighbor lists, perpetual/occasional/extra = 1 0 0
  (1) pair airebo, perpetual
      attributes: full, newton on, ghost
      pair build: full/bin/ghost
      stencil: full/ghost/bin/3d
      bin: standard
